{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["config/**/*.ts", "constants/**/*.ts", "fixtures/**/*.ts", "page/**/*.ts", "test-data/**/*.ts", "tests/**/*.ts", "types/**/*.ts"]
}
